{
  "name": "finfeed-web",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "FinFeed 实时财经新闻监控 — Vue 3 + Vite 前端（现代 SaaS 亮色风）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "audit:ui": "python scripts/ui_audit.py --root src --fail",
    "audit:a11y": "python scripts/contrast_audit.py --fail",
    "audit:pages": "python scripts/page_audit.py",
    "audit": "npm run audit:ui && npm run audit:a11y"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "echarts": "^5.5.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.27",
    "vue-router": "^4.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "vite": "^5.2.11"
  }
}
